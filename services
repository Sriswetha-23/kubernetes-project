apiVersion: v1
kind: Service
metadata:
  name: vote
spec:
  type: NodePort
  selector:
    name: vote
  ports:
  - port: 8080
    targetPort: 80
    nodePort: 31000

apiVersion: v1
kind: Service
metadata:
  name: result
spec:
  type: NodePort
  selector:
    name: result
  ports:
  - port: 8081
    targetPort: 80
    nodePort: 31001

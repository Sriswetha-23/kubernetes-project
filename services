apiVersion: v1
kind: Service
metadata:
  name: vote
spec:
  type: NodePort
  selector:
    name: voting-app-pod ---------------> Remember: This must be pod's label not deployment's
    app: voting-app-proj 
  ports:
  - port: 8080
    targetPort: 80
    nodePort: 31000

apiVersion: v1
kind: Service
metadata:
  name: result
spec:
  type: NodePort
  selector:
    name: result-app-pod
    app: result-app-proj 
  ports:
  - port: 8081
    targetPort: 80
    nodePort: 31001
